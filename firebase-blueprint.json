{
  "entities": {
    "user": {
      "title": "User",
      "description": "User account for technicians, controllers, and workshop administrators",
      "type": "object",
      "properties": {
        "UserID": { "type": "string", "description": "Employee or system ID e.g. EMP-001" },
        "Username": { "type": "string", "description": "Optional login handle e.g. somchai" },
        "Email": { "type": "string", "description": "User email address" },
        "Password": { "type": "string", "description": "Encrypted or workshop access password" },
        "Name": { "type": "string", "description": "Full staff name" },
        "Nickname": { "type": "string", "description": "Colloquial Thai nickname for shop floor UI" },
        "Role": { "type": "string", "enum": ["Admin", "Controller", "Technician"], "description": "User role permissions" },
        "Department": { "type": "string", "description": "Assigned workshop department" },
        "Skills": { "type": "string", "description": "Skill descriptions or certifications" },
        "Status": { "type": "string", "enum": ["Active", "Inactive"], "description": "Account status" }
      },
      "required": ["UserID", "Email", "Name", "Role", "Status"]
    },
    "job": {
      "title": "Job",
      "description": "Vehicle body and paint repair job order",
      "type": "object",
      "properties": {
        "JobID": { "type": "string", "description": "Job work order number e.g. JOB-2610-001" },
        "LicensePlate": { "type": "string", "description": "Vehicle license plate number" },
        "VIN": { "type": "string", "description": "Vehicle identification number" },
        "CustomerName": { "type": "string", "description": "Customer or insurance claimant name" },
        "JobType": { "type": "string", "description": "Job repair classification" },
        "JobDetails": { "type": "string", "description": "Description of damage and repair scope" },
        "DueDate": { "type": "string", "description": "Promised completion date in YYYY-MM-DD" },
        "DeliveryDate": { "type": "string", "description": "Customer vehicle delivery date in YYYY-MM-DD" },
        "Status": { "type": "string", "enum": ["Open", "In Progress", "Paused", "Completed"], "description": "Current overall job status" }
      },
      "required": ["JobID", "LicensePlate", "CustomerName", "DueDate", "Status"]
    },
    "jobTask": {
      "title": "JobTask",
      "description": "Standard operating procedure subtask assigned to technicians",
      "type": "object",
      "properties": {
        "TaskID": { "type": "string", "description": "Task identifier e.g. TSK-1001" },
        "JobID": { "type": "string", "description": "Parent job work order ID" },
        "TaskName": { "type": "string", "description": "Name of the repair operation step" },
        "AssignedTechs": { "type": "string", "description": "Comma-separated technician emails" },
        "StartDate": { "type": "string", "description": "Scheduled start date in YYYY-MM-DD" },
        "DueDate": { "type": "string", "description": "Target completion date in YYYY-MM-DD" },
        "Status": { "type": "string", "enum": ["Pending", "In Progress", "Paused", "Completed"], "description": "Task progress status" },
        "TotalMinutes": { "type": "number", "description": "Accumulated active technician work minutes" },
        "StandardMinutes": { "type": "number", "description": "Standard benchmark minutes for efficiency computation" },
        "PartsChecklist": { "type": "string", "description": "Serialized checklist of body parts and status" }
      },
      "required": ["TaskID", "JobID", "TaskName", "Status", "TotalMinutes", "StandardMinutes"]
    },
    "timeLog": {
      "title": "TimeLog",
      "description": "Work clock stamp action for technician time tracking",
      "type": "object",
      "properties": {
        "LogID": { "type": "string", "description": "Unique log record ID e.g. LOG-12345" },
        "TaskID": { "type": "string", "description": "Related task ID" },
        "TechEmail": { "type": "string", "description": "Email of the technician performing the action" },
        "Action": { "type": "string", "enum": ["START", "PAUSE", "COMPLETE"], "description": "Clock action performed" },
        "Timestamp": { "type": "string", "description": "ISO-8601 timestamp of log creation" },
        "DurationMinutes": { "type": "number", "description": "Elapsed duration in minutes for this segment" },
        "Note": { "type": "string", "description": "Technician pause reason or note" }
      },
      "required": ["LogID", "TaskID", "TechEmail", "Action", "Timestamp", "DurationMinutes"]
    },
    "workCalendar": {
      "title": "WorkCalendar",
      "description": "Workshop working day calendar and scheduled standard hours",
      "type": "object",
      "properties": {
        "Date": { "type": "string", "description": "Calendar date in YYYY-MM-DD format" },
        "IsWorkDay": { "type": "boolean", "description": "Whether this day is an official workshop work day" },
        "StandardHours": { "type": "number", "description": "Scheduled standard working hours for this day" }
      },
      "required": ["Date", "IsWorkDay", "StandardHours"]
    },
    "techLeave": {
      "title": "TechLeave",
      "description": "Technician leave or vacation request record",
      "type": "object",
      "properties": {
        "LeaveID": { "type": "string", "description": "Leave entry ID" },
        "TechEmail": { "type": "string", "description": "Technician email address" },
        "Date": { "type": "string", "description": "Leave date in YYYY-MM-DD" },
        "Type": { "type": "string", "description": "Type of leave e.g. ลากิจ, ลาป่วย" },
        "Notes": { "type": "string", "description": "Additional notes" }
      },
      "required": ["LeaveID", "TechEmail", "Date", "Type"]
    },
    "setting": {
      "title": "Setting",
      "description": "Workshop global system configuration key-value pair",
      "type": "object",
      "properties": {
        "ConfigKey": { "type": "string", "description": "Configuration key name" },
        "ConfigValue": { "type": "string", "description": "Configuration value" },
        "Description": { "type": "string", "description": "Description of the setting" }
      },
      "required": ["ConfigKey", "ConfigValue"]
    },
    "carPart": {
      "title": "CarPart",
      "description": "Master list item of vehicle body parts to paint/repair",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier or slug" },
        "name": { "type": "string", "description": "Car part name in Thai" }
      },
      "required": ["id", "name"]
    },
    "masterSopStage": {
      "title": "MasterSopStage",
      "description": "Master standard operating procedure stage definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Stage ID e.g. SOP-01" },
        "stepNumber": { "type": "number", "description": "Sequence step number" },
        "name": { "type": "string", "description": "Name of the SOP step" },
        "department": { "type": "string", "description": "Responsible department" },
        "defaultTechEmails": { "type": "string", "description": "Comma separated default technicians" },
        "standardMinutes": { "type": "number", "description": "Default standard minutes for this stage" }
      },
      "required": ["id", "stepNumber", "name", "standardMinutes"]
    },
    "department": {
      "title": "Department",
      "description": "Workshop master department record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Department ID e.g. DEPT-01" },
        "name": { "type": "string", "description": "Department name in Thai" },
        "description": { "type": "string", "description": "Department description" }
      },
      "required": ["id", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User accounts for technicians, controllers, and admins"
    },
    "/jobs/{jobId}": {
      "schema": "job",
      "description": "Repair work orders with vehicle details and schedule"
    },
    "/jobTasks/{taskId}": {
      "schema": "jobTask",
      "description": "Individual repair steps, assigned techs, and time spent"
    },
    "/timeLogs/{logId}": {
      "schema": "timeLog",
      "description": "Technician start, pause, and complete time entries"
    },
    "/workCalendar/{calendarId}": {
      "schema": "workCalendar",
      "description": "Shop calendar working days and standard available hours"
    },
    "/techLeaves/{leaveId}": {
      "schema": "techLeave",
      "description": "Technician leave and vacation records"
    },
    "/settings/{settingId}": {
      "schema": "setting",
      "description": "Workshop global configurations and operational parameters"
    },
    "/carParts/{partId}": {
      "schema": "carPart",
      "description": "Master body parts available for repair checklists"
    },
    "/masterSopStages/{stageId}": {
      "schema": "masterSopStage",
      "description": "Master SOP repair stages and baseline standard times"
    },
    "/departments/{deptId}": {
      "schema": "department",
      "description": "Workshop master departments"
    }
  }
}
